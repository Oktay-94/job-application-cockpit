# --- Pflicht ---------------------------------------------------------------
# Postgres-Verbindung (Schema: sql/schema.sql, Demo-Daten: sql/seed-demo.sql).
# Für eine öffentliche Demo einen READ-ONLY-Datenbank-User verwenden.
DATABASE_URL=postgres://user:password@localhost:5432/cockpit

# --- Demo-Modus -------------------------------------------------------------
# true = alle schreibenden API-Routen blocken ({ ok: false, demo: true }).
# Der Demo-Modus ist AUCH aktiv, wenn die N8N_*-Variablen unten fehlen.
DEMO_MODE=true

# --- Optional: KI-Agent-Chat (app/api/agent) --------------------------------
# Ohne Key ist die Agent-Seite deaktiviert, der Rest der App läuft normal.
ANTHROPIC_API_KEY=

# --- Optional: lokaler Dokumente-Ordner (Anhänge auf der Detailseite) -------
# Ohne Wert zeigt die Dokumente-Karte einen Hinweis statt Dateien.
BEWERBUNGEN_DIR=

# --- Optional: Automations-Backend (n8n-Webhooks) ---------------------------
# Nur nötig, wenn ein echtes n8n die Aktionen (Senden, Bündeln, Restamp)
# ausführen soll. Fehlen diese Werte, greift automatisch der Demo-Modus.
N8N_WEBHOOK_URL=
N8N_BUENDELN_WEBHOOK_URL=
N8N_RESTAMP_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Optional: Dev von anderen Geräten (next.config.ts) ---------------------
# Kommagetrennte Origins, z. B. "192.168.0.*,mein-host.example"
DEV_ORIGINS=
